{
  "name": "minicrm",
  "version": "1.0.0",
  "description": "Standalone mini CRM: Node.js HTTP API + built-in SQLite database + vanilla JS frontend. Zero dependencies.",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  }
}
